<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="733.0" prefWidth="963.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.joaosecalebe.Controller.ControllerCadastroFuncionario">

    <children>
        <Label layoutX="328.0" layoutY="141.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Cadastrar funcionário" />

        <TextField fx:id="txNome" layoutX="250.0" layoutY="249.0" prefWidth="430.0" promptText="Nome completo" />

        <TextField fx:id="txCpf" layoutX="250.0" layoutY="302.0" prefWidth="430.0" promptText="CPF" />

        <TextField fx:id="txCargo" layoutX="250.0" layoutY="357.0" prefWidth="430.0" promptText="Cargo" />

        <TextField fx:id="txSalario" layoutX="250.0" layoutY="412.0" prefWidth="430.0" promptText="Salário" />

        <Button layoutX="250.0" layoutY="489.0" onAction="#confirmar" prefWidth="200.0" text="Confirmar" />

        <Button layoutX="480.0" layoutY="489.0" onAction="#cancelar" prefWidth="200.0" text="Cancelar" />
    </children>
</AnchorPane>
